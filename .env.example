# ===========================================
# GiveToAfrica — Environment Variables
# Copy to .env and fill in real values
# ===========================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/givetoafrica

# --- Stripe (cards, Apple Pay, Google Pay) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal (PayPal balance, cards via PayPal, Venmo) ---
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
PAYPAL_MODE=sandbox

# --- NOWPayments (cryptocurrency) ---
NOWPAYMENTS_API_KEY=...
NOWPAYMENTS_IPN_SECRET=...

# --- Auth ---
MAGIC_LINK_SECRET=...
JWT_SECRET=...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=donations@givetoafrica.org

# --- Admin ---
ADMIN_EMAIL=admin@givetoafrica.org

# --- App URLs ---
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# --- Server ---
PORT=4000
NODE_ENV=development
