{
  "name": "givetoafrica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build",
    "build:ssg": "tsc && vite build && node scripts/sitemap.mjs && node scripts/robots.mjs && node scripts/prerender.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:hostpinnacle": "npm run build:ssg && npm run build:server && npm run notify-google:site",
    "start": "node dist/server/index.js",
    "start:pm2": "pm2 start dist/server/index.js --name givetoafrica",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "notify-google": "node scripts/notify-google.mjs",
    "notify-google:site": "node scripts/notify-google.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@prisma/client": "^5.15.0",
    "@stripe/stripe-js": "^3.5.0",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^11.2.10",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.390.0",
    "morgan": "^1.10.0",
    "prisma": "^5.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.23.1",
    "resend": "^3.2.0",
    "stripe": "^15.11.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "puppeteer-core": "^25.4.0",
    "react-helmet-async": "^3.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
